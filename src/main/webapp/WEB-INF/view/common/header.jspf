					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=employee-register">사원
							등록</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=attendance-settings">휴가/근태
							설정</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=payroll-settings">급여항목
							설정</a></li>
				</ul></li>
			<li class="main-nav__item"><a class="main-nav__trigger"
				href="${pageContext.request.contextPath}/example.do?menu=hr">인사관리</a>
				<ul class="dropdown-menu">
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=employee-management">사원현황/관리</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=hr-card">인사기록
							카드</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=certificate-issue">제증명서
							발급</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=certificate-ledger">제증명서
							발급대장</a></li>
				</ul></li>
			<li class="main-nav__item"><a class="main-nav__trigger"
				href="${pageContext.request.contextPath}/example.do?menu=attendance">근태관리</a>
				<ul class="dropdown-menu">
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=attendance-management">근태기록/관리</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=attendance-search">근태조회</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=leave-search">휴가조회</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=daily-attendance">일용직
							근무기록/관리</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=daily-search">일용직
							근무 조회</a></li>
				</ul></li>
			<li class="main-nav__item"><a class="main-nav__trigger"
				href="${pageContext.request.contextPath}/example.do?menu=payroll">급여관리</a>
				<ul class="dropdown-menu">
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=payroll-management">급여입력/관리</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=daily-payroll">급여입력/관리(일용직)</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=payroll-ledger">급여대장</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=payslip">급여명세서</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=employee-payroll">사원별
							급여내역</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=pay-transfer">급여이체
							신청</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=transfer-result">급여이체
							결과조회</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=item-ledger">항목별
							대장</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=deduction">4대보험
							공제내역</a></li>
				</ul></li>
			<li class="main-nav__item"><a class="main-nav__trigger"
				href="${pageContext.request.contextPath}/example.do?menu=statistics">급여통계</a>
				<ul class="dropdown-menu">
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=annual-total">연도별
							전체급여 통계</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=monthly-total">월별
							전체급여 통계</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=annual-personal">연도별
							개인연봉 통계</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=monthly-personal">월별
							개인급여 통계</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=payroll-composition">급여항목
							구성 통계</a></li>
				</ul></li>
			<li class="main-nav__item"><a class="main-nav__trigger"
				href="${pageContext.request.contextPath}/example.do?menu=retirement">퇴직관리</a>
				<ul class="dropdown-menu">
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=retirement-process">사원
							퇴직처리</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=retirement-pay">퇴직급여
							입력/관리</a></li>
					<li><a class="dropdown-menu__link"
						href="${pageContext.request.contextPath}/example.do?menu=retirement-payslip">퇴직급여명세서</a></li>
				</ul></li>
