<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- フルページレイアウトとヘッダーのみのスタイル --%>
<link rel="stylesheet"
	href="${pageContext.request.contextPath}/css/common/common.css">
<link rel="stylesheet"
	href="${pageContext.request.contextPath}/css/common/header.css?v=20260820-2">

<header class="site-header">
	<!-- サイト名とホームリンクエリア -->
	<div class="site-header__brand">
		<div class="site-header__logo">
			<img src="${pageContext.request.contextPath}/images/header/payzon-logo-light.png" alt="PAYZON">
		</div>
	</div>

	<!-- 頻繁に使用するタスクに直接アクセスできるアイコン メニュー -->
	<ul class="quick-menu">
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/home.do"> <img
				class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/home.png">
				<span>HOME</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/settings/register1.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/employee-register.png">
				<span>社員登録</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/employees/employees.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/employee-status.png">
				<span>社員状況</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/employees/certificate.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/certificate.png">
				<span>各種証明書発行</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/attendance/attendance-management.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/attendance.png">
				<span>勤怠記録/管理</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/example.do?menu=leave">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/leave.png">
				<span>休暇照会</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/payroll/management.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/payroll.png">
				<span>給与入力/管理</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/payroll/day-worker-management.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/daily-payroll.png">
				<span>給与入力/管理（日雇い）</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/payroll/register.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/payroll-ledger.png">
				<span>給与台帳</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/payroll/payslip.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/payslip.png">
				<span>給与明細書</span>
		</a></li>
		<li class="quick-menu__item"><a class="quick-menu__link"
			href="${pageContext.request.contextPath}/payroll/employee-history.do">
				<img class="quick-menu__icon-image"
				src="${pageContext.request.contextPath}/images/header/employee-payroll.png">
				<span>社員別給与履歴</span>
		</a></li>
	</ul>

