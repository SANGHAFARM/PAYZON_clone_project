<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%-- フッターのみのスタイル --%>
<link rel="stylesheet"
	href="${pageContext.request.contextPath}/css/common/footer.css">

<footer class="site-footer">
	<div class="site-footer__inner">
		<!-- カスタマーセンターの電話番号と営業時間 -->
		<div class="site-footer__summary">
			<section>
				<p class="site-footer__center-label">CUSTOMER CENTER</p>
				<p class="site-footer__phone">0000-0000</p>
			</section>

			<dl class="site-footer__hours">
				<div class="site-footer__hours-row">
					<dt>平日</dt>
					<dd>午前10時～午後5時50分</dd>
				</div>
				<div class="site-footer__hours-row">
					<dt>ランチタイム</dt>
					<dd>午前12:50～午後2:00</dd>
				</div>
				<div class="site-footer__hours-row">
					<dt>休業日</dt>
					<dd>週末と祝日</dd>
				</div>
			</dl>
		</div>

		<!-- 会社情報と著作権表示 -->
		<div class="site-footer__company">
			<p>ソウル市江南区恩州路603・事業者登録番号 000-00-0000・TEL 0000-0000・FAX
				00-0000-0000</p>
			<p class="site-footer__copyright">Copyright &copy; 2026 PAYZON.
				LTD. All rights reserved.</p>
		</div>
	</div>
</footer>
